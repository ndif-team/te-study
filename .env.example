# Study configuration. Everything here is VITE_-prefixed and therefore inlined
# into the public bundle — see src/study/env.ts for why that is safe.

# Supabase project holding TE-arm telemetry. Standalone project: NOT the
# Workbench project. Leave both blank to run as plain Transformer Explainer
# with telemetry disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the participant is sent after the final unit. Qualtrics issues the
# Prolific completion code (Jul 21 decision); this app never holds it.
VITE_QUALTRICS_POST_SURVEY_URL=

# Skips the 657 MB ONNX download and uses TE's built-in cached-example data.
# For the E2E suite only — must NEVER be true for a real build.
VITE_STUDY_MOCK_MODEL=false

# Set to false to unmount the study wrapper entirely (plain Transformer Explainer).
VITE_STUDY_ENABLED=true
